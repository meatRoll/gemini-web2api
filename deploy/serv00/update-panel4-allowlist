#!/bin/sh
set -eu

# This command is installed as an SSH forced command. It reads exactly one IP
# from stdin and atomically replaces the application allowlist.
read -r ip
[ -n "${ip:-}" ]
/usr/local/bin/python3 - "$ip" <<'PY'
import ipaddress
import json
import os
import sys
import tempfile
import time

path = "/home/igsshan/gemini-web2api/panel4-allowlist.json"
ip = str(ipaddress.ip_address(sys.argv[1]))
directory = os.path.dirname(path)
fd, temporary = tempfile.mkstemp(prefix=".panel4-allowlist-", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as output:
        json.dump({"ips": [ip], "updated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}, output)
        output.write("\n")
        output.flush()
        os.fsync(output.fileno())
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
    temporary = None
    print("allowlist updated")
finally:
    if temporary:
        os.unlink(temporary)
PY
